{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/scripts/session-start.js"
      },
      {
        "command": "node .agents/hooks/agent-event.mjs cursor session-start"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .agents/hooks/agent-event.mjs cursor edit"
      }
    ],
    "stop": [
      {
        "command": "node .agents/hooks/agent-event.mjs cursor stop"
      }
    ]
  }
}