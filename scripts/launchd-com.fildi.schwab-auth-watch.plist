<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fildi.schwab-auth-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/jamiepark/Cursor/fildi/scripts/schwab-auth-watch.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jamiepark/Cursor/fildi</string>
  <!-- 5 min: a missed interval fires once on wake, so it checks within minutes of opening the Mac -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- ~/.tradedash survives reboot (/tmp does not; a missing log dir stops launchd starting the job) -->
  <key>StandardOutPath</key><string>/Users/jamiepark/.tradedash/schwab-auth-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/jamiepark/.tradedash/schwab-auth-watch.log</string>
</dict>
</plist>
